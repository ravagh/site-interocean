# Copy to .env (local) or set in Vercel → Project → Settings → Environment Variables.

# Canonical origin used for <link rel="canonical">, Open Graph URLs and sitemap.xml
VITE_SITE_URL=https://www.interoceanco.com

# Contact form endpoint (POST, JSON). Leave empty until a real backend exists:
# the form then validates and clearly tells the visitor that online submission
# is not available yet — it never pretends a message was sent.
VITE_FORM_ENDPOINT=/api/contact/

# Optional public business email. When set, it is shown on the Contact page and
# offered as an alternative when online submission is unavailable.
VITE_CONTACT_EMAIL=info@interoceanco.com

# --- Server-only (api/contact.js) — never prefix these with VITE_ ---
# Resend API key (Sending access, restricted to interoceanco.com)
RESEND_API_KEY=
# Recipient(s), comma-separated
CONTACT_TO=info@interoceanco.com
# Sender — must use the domain verified in Resend
CONTACT_FROM=Inter Ocean Website <website@interoceanco.com>
